{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "password-manager",
    "version": "0.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "scope": [
          "C:/Users/luhlu/Documents/passwords/tests/accounts.json",
          "C:/Users/luhlu/Documents/passwords/tests/accounts.txt",
          "C:/Users/luhlu/Documents/passwords/ids.json"
        ]
      }
    },
    "windows": [
      {
        "title": "Password Manager",
        "width": 1400,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.tauri.dev",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "src/icons/copy.svg"
      ]
    }
  }
}
