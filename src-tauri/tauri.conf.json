{
  "identifier": "l8c2s.password-manager.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Password Manager",
  "mainBinaryName": "Password Manager",
  "version": "0.8.2",
  "plugins": {},
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Gerenciador de Senhas v0.8.2",
        "width": 1100,
        "center": true,
        "resizable": true,
        "maximizable": true
      }
    ]
  }
}